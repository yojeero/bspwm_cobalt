configuration {
    modi: "drun,run";
    show-match: "drun";
    lines: 6;
    font: "JetBrains Mono 9"; 
    show-icons: true;
    icon-theme: "Papirus"; 
    terminal: "alacritty";
    location: 0;
    disable-history: false;
    hide-scrollbar: false;    

    display-drun: "   Apps ";
    display-run: "   Run ";
    
    hover-select: true;
    sidebar-mode: true;
}

window {
    height: 460px;
    border: 0; 
    border-radius: 12px; 
    background-color: #012b4a;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ mode-switcher, entry ];
    background-color: transparent;
    border-radius: 6px;
    padding: 2px;
}

prompt {
    enabled: false;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 20px 20px 0px 10px;
    text-color: #ffffff;
    background-color: transparent;
    placeholder: "Search...";
    placeholder-color: #a3b8cc;
}

listview {
    border: 0px;
    margin: 10px 10px 0px 20px;
    padding: 0px 20px 0px 0px;  
    scrollbar: true;            
    dynamic: true;              
    columns: 3;
    background-color: transparent;
}

element {
    padding: 8px 12px; 
    margin: 2px 0px 0px 4px;
    background-color: transparent;
    border-radius: 4px;
    text-color: inherit;
    orientation: horizontal; 
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;  
    vertical-align: 0.5;     
} 

element-text {
    vertical-align: 0.5;       
    background-color: transparent;
    text-color: inherit;
}

element normal.normal {
    background-color: transparent;
    text-color: #a3b8cc;
}

element alternate.normal {
    background-color: transparent;
    text-color: #a3b8cc;
}

element selected.normal {
    background-color: #ffc600;
    text-color: #252525;
}

mode-switcher {
    spacing: 5px;
    margin: 20px 0px 0px 20px; 
    background-color: transparent;
}

button {
    padding: 6px 12px;
    background-color: #1f4662;
    text-color: #a3b8cc;
    border-radius: 4px;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: #ffc600;
    text-color: #15232d;
}

scrollbar {
    width:        4px;          
    border:       0;
    handle-color: #ffc600;   
    handle-width: 8px;
    background-color: #1f4662; 
    margin:       10px 0px 30px 20px; 
}
